# ==============================================================================
# AI Citizen Grievance & Admin Operations Platform - Configuration Template
# ==============================================================================

# Backend API Service (FastAPI)
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Database Configuration (SQLite by default, easily swapped with PostgreSQL)
DATABASE_URL=sqlite:///./grievances.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/grievances_db

# Local Ollama AI Classifier Engine
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=45

# Administrative Security & JWT Authentication
JWT_SECRET=grievance-admin-secret-key-super-secure-2026-prod
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Default Pre-Configured Administrator Account
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@Grievance2026

# Web Application Ports:
# Citizen Portal Frontend:  http://localhost:5173  (citizen-frontend/)
# Admin Dashboard Frontend: http://localhost:5174  (admin-frontend/)
# Backend API & Docs:       http://localhost:8000  (FastAPI Swagger: /docs)
